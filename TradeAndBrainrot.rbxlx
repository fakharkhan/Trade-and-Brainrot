			<string name="Name">ServerScriptService</string>
		</Properties>
			<Item class="Script" referent="RBX15">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--[[
	Trade and Brainrot — main server entry.
	Loads modules with pcall isolation so one failure cannot stop the game.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Ensure Shared modules are require-able (Rojo maps ReplicatedStorage.Shared)
local function boot()
	local Util = require(script.Parent.Modules.Util)
	local Remotes = require(ReplicatedStorage.Shared.Remotes)
	local DataService = require(script.Parent.Modules.DataService)
	local Bases = require(script.Parent.Modules.Bases)
	local Track = require(script.Parent.Modules.Track)
	local Shop = require(script.Parent.Modules.Shop)
	local Economy = require(script.Parent.Modules.Economy)
	local PlayersService = require(script.Parent.Modules.PlayersService)

	Util.safe("DataService.init", function()
		DataService.init()
		DataService.startAutosave()
		DataService.bindToClose()
	end)

	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace

	Util.safe("world", function()
		Util.makePart("Ground", Vector3.new(400, 1, 220), Vector3.new(0, -0.5, 0), Color3.fromRGB(90, 140, 80), Enum.Material.Grass, map)

		local spawn = Instance.new("SpawnLocation")
		spawn.Position = Vector3.new(0, 1, 75)
		spawn.Size = Vector3.new(12, 1, 12)
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Parent = map

		local wallColor = Color3.fromRGB(110, 110, 120)
		local H, T = 20, 2
		local halfX, halfZ = 190, 110
		Util.makePart("Wall_N", Vector3.new(halfX * 2, H, T), Vector3.new(0, H / 2, -halfZ), wallColor, Enum.Material.Concrete, map)
		Util.makePart("Wall_S", Vector3.new(halfX * 2, H, T), Vector3.new(0, H / 2, halfZ), wallColor, Enum.Material.Concrete, map)
		Util.makePart("Wall_W", Vector3.new(T, H, halfZ * 2), Vector3.new(-halfX, H / 2, 0), wallColor, Enum.Material.Concrete, map)
		Util.makePart("Wall_E", Vector3.new(T, H, halfZ * 2), Vector3.new(halfX, H / 2, 0), wallColor, Enum.Material.Concrete, map)

		Bases.buildAll(map)
		Bases.installApi()
	end)

	Util.safe("Track.start", function() Track.start(map) end)
	Util.safe("Shop.showcase", function() Shop.buildShowcase(map) end)
	Util.safe("Shop.super", function() Shop.buildSuperStand(map) end)
	Util.safe("Shop.rebirth", function() Shop.buildRebirthPad(map) end)
	Util.safe("Progress", function() require(script.Parent.Modules.Progress).start() end)
	Util.safe("Economy", function() Economy.startIncomeLoop() end)
	Util.safe("PlayersService", function() PlayersService.start() end)

	-- Touch remotes so they exist
	local _ = Remotes.GameEvent
	local _2 = Remotes.IncomeUpdate

	print("[TradeBrainrot] World ready. Modules loaded.")
end

local ok, err = pcall(boot)
if not ok then
	warn("[TradeBrainrot] FATAL boot failure: " .. tostring(err))
end
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<string name="Name">Main</string>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX16">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- TradeServer: player-to-player trades with expiry, validation, and optional slot indices.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local RateLimit = require(script.Parent.Modules.RateLimit)

local event = ReplicatedStorage:FindFirstChild("TradeEvent")
if not event then
	event = Instance.new("RemoteEvent")
	event.Name = "TradeEvent"
	event.Parent = ReplicatedStorage
end

local api = ServerStorage:WaitForChild("BaseApi", 60)

local pending = {} -- [targetUserId] = { from, give, want, indices?, expires }

local function coinsOf(player)
	local stats = player:FindFirstChild("leaderstats")
	return stats and stats:FindFirstChild("Coins")
end

local function notify(player, message)
	if player and player.Parent == Players then
		event:FireClient(player, "Message", message)
	end
end

local function clearExpired()
	local now = os.clock()
	for id, offer in pairs(pending) do
		if offer.expires and now > offer.expires then
			pending[id] = nil
			if offer.from and offer.from.Parent == Players then
				notify(offer.from, "Your trade offer expired.")
			end
			local target = Players:GetPlayerByUserId(id)
			if target then
				event:FireClient(target, "TradeExpired")
			end
		end
	end
end

task.spawn(function()
	while true do
		task.wait(5)
		pcall(clearExpired)
	end
end)

event.OnServerEvent:Connect(function(player, action, a, b, c, d)
	if typeof(action) ~= "string" then return end
	if not RateLimit.allow(player, "trade_" .. action, Config.RemoteRateLimitSeconds) then
		return
	end

	if action == "ListMySlots" then
		if not api then return end
		local list = api:Invoke("ListSlots", player)
		event:FireClient(player, "MySlots", list)
		return
	end

	if action == "Offer" then
		if api and api:Invoke("IsCarrying", player) then
			notify(player, "Place your carried brainrot before trading.")
			return
		end
		local target = Players:GetPlayerByUserId(tonumber(a) or 0)
		local give, want = math.floor(tonumber(b) or 0), math.floor(tonumber(c) or 0)
		local indices = typeof(d) == "table" and d or nil

		if not target or target == player then return end
		if give < 1 or want < 0 or give > 8 or want > 1000000 then
			notify(player, "Invalid offer.")
			return
		end
		if not api then
			notify(player, "Trade system not ready.")
			return
		end
		if api:Invoke("Count", player) < give then
			notify(player, "You don't have that many brainrots.")
			return
		end
		if indices then
			if #indices ~= give then
				notify(player, "Selected brainrots don't match offer count.")
				return
			end
			for _, idx in ipairs(indices) do
				if typeof(idx) ~= "number" then
					notify(player, "Invalid slot selection.")
					return
				end
			end
		end

		pending[target.UserId] = {
			from = player,
			give = give,
			want = want,
			indices = indices,
			expires = os.clock() + Config.TradeOfferExpireSeconds,
		}
		notify(player, "Offer sent to " .. target.DisplayName .. " (expires in " .. Config.TradeOfferExpireSeconds .. "s)")
		event:FireClient(target, "Incoming", player.UserId, player.DisplayName, give, want, indices)

	elseif action == "Respond" then
		local offer = pending[player.UserId]
		pending[player.UserId] = nil
		if not offer then return end
		if offer.expires and os.clock() > offer.expires then
			notify(player, "That offer already expired.")
			return
		end

		local from = offer.from
		if not from or from.Parent ~= Players then return end

		if not a then
			notify(from, player.DisplayName .. " declined your trade.")
			return
		end

		if api and (api:Invoke("IsCarrying", player) or api:Invoke("IsCarrying", from)) then
			notify(player, "Trade failed: someone is carrying a brainrot.")
			notify(from, "Trade failed: someone is carrying a brainrot.")
			return
		end

		local fromCoins, toCoins = coinsOf(from), coinsOf(player)
		if not (fromCoins and toCoins) then return end

		if api:Invoke("Count", from) < offer.give then
			notify(player, "Trade failed: they no longer have the brainrots.")
			notify(from, "Trade failed: not enough brainrots.")
			return
		end
		if api:Invoke("Free", player) < offer.give then
			notify(player, "Trade failed: your base doesn't have enough free pedestals.")
			notify(from, "Trade failed: " .. player.DisplayName .. "'s base is full.")
			return
		end
		if toCoins.Value < offer.want then
			notify(player, "Trade failed: you don't have enough Coins.")
			notify(from, "Trade failed: " .. player.DisplayName .. " doesn't have enough Coins.")
			return
		end

		local ok
		if offer.indices then
			ok = api:Invoke("TransferSlots", from, player, offer.indices)
		else
			ok = api:Invoke("Transfer", from, player, offer.give)
		end
		if not ok then
			notify(from, "Trade failed.")
			notify(player, "Trade failed.")
			return
		end
		toCoins.Value -= offer.want
		fromCoins.Value += offer.want

		notify(from, ("Trade done! You gave %d brainrots and got %d Coins."):format(offer.give, offer.want))
		notify(player, ("Trade done! You got %d brainrots and paid %d Coins."):format(offer.give, offer.want))
	end
end)

Players.PlayerRemoving:Connect(function(p)
	pending[p.UserId] = nil
	for id, offer in pairs(pending) do
		if offer.from == p then pending[id] = nil end
	end
end)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<string name="Name">TradeServer</string>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX17">
				<Properties>
					<string name="Name">Modules</string>
				</Properties>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local BrainrotDefs = require(ReplicatedStorage.Shared.BrainrotDefs)
local Util = require(script.Parent.Util)
local BrainrotModels = require(script.Parent.BrainrotModels)
local Carry = require(script.Parent.Carry)
local RateLimit = require(script.Parent.RateLimit)

local Bases = {
	list = {},
	baseOf = {},
	stealCooldown = {},
	stealProtectUntil = {}, -- [player] = clock
	map = nil,
	onChanged = nil, -- optional callback(player) after slot change
}

local function incomeOf(slot, player)
	local data = nil
	local ok, DataService = pcall(function() return require(script.Parent.DataService) end)
	if ok and DataService then
		data = DataService.get(player)
	end
	return Util.incomeOf(slot, data and data.Rebirths or 0, data and data.Level or 1)
end

function Bases.slotText(slot, player)
	if not slot then return "" end
	local name = slot.Super and ("SUPER " .. slot.Def.Name) or slot.Def.Name
	return ("%s\n+%d/s"):format(name, incomeOf(slot, player))
end

function Bases.updateSign(base)
	base.SignLabel.Text = base.Owner and (base.Owner.DisplayName .. "'s Base") or ("Base " .. base.Index .. " (free)")
end

function Bases.countOwned(player)
	local base = Bases.baseOf[player]
	if not base then return 0 end
	local n = 0
	for i = 1, #base.Pedestals do
		if base.Slots[i] then n += 1 end
	end
	return n
end

function Bases.freeSlots(player)
	local base = Bases.baseOf[player]
	if not base then return 0 end
	return #base.Pedestals - Bases.countOwned(player)
end

function Bases.firstFreeSlot(base)
	for i = 1, #base.Pedestals do
		if not base.Slots[i] then return i end
	end
end

function Bases.totalIncome(player)
	local base = Bases.baseOf[player]
	if not base then return 0 end
	local total = 0
	for i = 1, #base.Pedestals do
		local slot = base.Slots[i]
		if slot then total += incomeOf(slot, player) end
	end
	return total
end

function Bases.refreshSlot(base, i)
	local ped = base.Pedestals[i]
	local slot = base.Slots[i]
	if ped.Model then
		ped.Model:Destroy()
		ped.Model = nil
	end
	if slot then
		local m = BrainrotModels.build(slot.Def, slot.Super)
		m.Parent = base.Folder
		m:PivotTo(CFrame.new(ped.Pad.Position + Vector3.new(0, 0.5 + Util.footOf(slot.Def), 0)) * CFrame.Angles(0, -base.FrontDir * Util.PI / 2, 0))
		ped.Model = m
		ped.Pick.ObjectText = slot.Def.Name
		BrainrotModels.playSpawnPop(m)
		BrainrotModels.startIdleBob(m)
		local color = Util.rarityColor(slot.Def.Rarity)
		ped.Label.TextColor3 = color
	end
	ped.Pick.Enabled = slot ~= nil
	ped.Place.Enabled = slot == nil
	ped.Label.Text = Bases.slotText(slot, base.Owner)
	ped.Label.Parent.Enabled = slot ~= nil
	if base.Owner then
		local stat = Util.getStat(base.Owner, "Brainrots")
		if stat then stat.Value = Bases.countOwned(base.Owner) end
		local incomeStat = Util.getStat(base.Owner, "Income")
		if incomeStat then incomeStat.Value = Bases.totalIncome(base.Owner) end
		if Bases.onChanged then
			Bases.onChanged(base.Owner)
		end
	end
end

-- Update pedestal labels and income stat without rebuilding models (used after level-ups)
function Bases.refreshLabels(player)
	local base = Bases.baseOf[player]
	if not base then return end
	for i = 1, #base.Pedestals do
		local slot = base.Slots[i]
		if slot then
			base.Pedestals[i].Label.Text = Bases.slotText(slot, player)
		end
	end
	local incomeStat = Util.getStat(player, "Income")
	if incomeStat then incomeStat.Value = Bases.totalIncome(player) end
end

function Bases.returnCarry(player)
	local c = Carry.get(player)
	if not c then return end
	local base = Bases.baseOf[player]
	local i = base and Bases.firstFreeSlot(base)
	if i then
		base.Slots[i] = c.Slot
		Bases.refreshSlot(base, i)
	end
	Carry.drop(player)
end

function Bases.pickUp(player, base, i)
	if not RateLimit.allow(player, "pick", 0.2) then return end
	local slot = base.Slots[i]
	if not slot then return end
	if Carry.isCarrying(player) then
		Util.notify(player, "You're already carrying a brainrot. Place it first!")
		return
	end
	local stealing = base.Owner ~= player
	if stealing then
		local protectUntil = Bases.stealProtectUntil[base.Owner]
		if protectUntil and os.clock() < protectUntil then
			Util.notify(player, "That base is protected after a recent steal.")
			return
		end
		local left = Config.StealCooldown - (os.clock() - (Bases.stealCooldown[player] or -999))
		if left > 0 then
			Util.notify(player, ("Steal is on cooldown (%ds)."):format(math.ceil(left)))
			return
		end
	end
	if not Carry.attach(player, slot) then return end
	base.Slots[i] = nil
	Bases.refreshSlot(base, i)
	if stealing then
		Bases.stealCooldown[player] = os.clock()
		if base.Owner then
			Bases.stealProtectUntil[base.Owner] = os.clock() + Config.StealProtectSeconds
			Util.notify(base.Owner, player.DisplayName .. " stole your " .. slot.Def.Name .. "!")
		end
		Util.notify(player, "You stole " .. slot.Def.Name .. "! Carry it to your base.")
	end
end

function Bases.place(player, base, i)
	if not RateLimit.allow(player, "place", 0.15) then return end
	if base.Owner ~= player then
		Util.notify(player, "That's not your base.")
		return
	end
	local c = Carry.get(player)
	if not c then
		Util.notify(player, "Pick up a brainrot first.")
		return
	end
	if base.Slots[i] then return end
	base.Slots[i] = c.Slot
	Carry.drop(player)
	Bases.refreshSlot(base, i)
	Util.notify(player, "Placed " .. base.Slots[i].Def.Name .. "!")
end

function Bases.sellCarried(player)
	if not RateLimit.allow(player, "sell", 0.3) then return end
	local c = Carry.get(player)
	if not c then
		Util.notify(player, "Carry a brainrot to the Trader to sell it.")
		return
	end
	local value = math.floor(c.Slot.Def.Price * (c.Slot.Super and Config.SuperMultiplier or 1) * Config.SellFraction)
	local coins = Util.getStat(player, "Coins")
	if coins then coins.Value += value end
	Util.notify(player, ("Trader bought %s for %d coins."):format(c.Slot.Def.Name, value))
	Carry.drop(player)
	if Bases.onChanged then Bases.onChanged(player) end
end

local function buildTrader(parent, origin)
	local model = Instance.new("Model")
	model.Name = "Trader"
	local skin = Color3.fromRGB(240, 200, 160)
	local coat = Color3.fromRGB(120, 50, 60)
	local pants = Color3.fromRGB(50, 50, 70)
	local hat = Color3.fromRGB(30, 30, 35)
	local BALL, BLOCK, CYL = Enum.PartType.Ball, Enum.PartType.Block, Enum.PartType.Cylinder
	local V3 = Vector3.new
	local function np(shape, size, cf, color, material)
		local p = Instance.new("Part")
		p.Shape = shape
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.Parent = model
		return p
	end
	for _, sx in ipairs({ -1, 1 }) do
		np(BLOCK, V3(0.9, 2, 0.9), origin * CFrame.new(sx * 0.55, 1, 0), pants)
		np(BLOCK, V3(0.8, 2.2, 0.8), origin * CFrame.new(sx * 1.55, 3.2, 0), coat)
		np(BALL, V3(0.9, 0.9, 0.9), origin * CFrame.new(sx * 1.55, 2.0, 0), skin)
	end
	np(BLOCK, V3(2.3, 2.4, 1.3), origin * CFrame.new(0, 3.2, 0), coat)
	local head = np(BALL, V3(1.8, 1.8, 1.8), origin * CFrame.new(0, 5.2, 0), skin)
	for _, sx in ipairs({ -1, 1 }) do
		np(BALL, V3(0.3, 0.3, 0.3), origin * CFrame.new(sx * 0.4, 5.4, -0.8), Color3.new(0.05, 0.05, 0.05))
	end
	np(BLOCK, V3(0.9, 0.25, 0.3), origin * CFrame.new(0, 4.9, -0.85), Color3.fromRGB(80, 50, 30))
	np(CYL, V3(0.25, 2.8, 2.8), origin * CFrame.new(0, 6.1, 0) * CFrame.Angles(0, 0, Util.PI / 2), hat)
	np(CYL, V3(1.5, 1.8, 1.8), origin * CFrame.new(0, 6.9, 0) * CFrame.Angles(0, 0, Util.PI / 2), hat)
	np(BALL, V3(1.4, 1.4, 1.4), origin * CFrame.new(-1.9, 1.5, -0.6), Color3.fromRGB(140, 100, 50))
	np(CYL, V3(0.2, 0.9, 0.9), origin * CFrame.new(-1.9, 2.3, -0.6) * CFrame.Angles(0, 0, Util.PI / 2), Util.GOLD, Enum.Material.Neon)
	model.Parent = parent
	Util.makeLabel(head, "Trader", UDim2.fromOffset(80, 24), Vector3.new(0, 2.5, 0), 40)
	return model
end

function Bases.buildOne(index, placeIndex, pos, map)
	local frontDir = (placeIndex == 1) and 1 or -1
	local base = { Index = index, Pos = pos, Owner = nil, Slots = {}, Pedestals = {}, FrontDir = frontDir }
	local folder = Instance.new("Folder")
	folder.Name = "Base_" .. index
	folder.Parent = map
	base.Folder = folder

	local color = (placeIndex == 1) and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(120, 180, 255)
	Util.makePart("Floor", Vector3.new(Config.BaseSize, 1, Config.BaseSize), pos + Vector3.new(0, 0.5, 0), color, nil, folder)

	local fence = Color3.fromRGB(90, 90, 100)
	local half = Config.BaseSize / 2
	Util.makePart("FenceBack", Vector3.new(1, 6, Config.BaseSize), pos + Vector3.new(-frontDir * half, 4, 0), fence, Enum.Material.Metal, folder)
	Util.makePart("FenceSideA", Vector3.new(Config.BaseSize, 6, 1), pos + Vector3.new(0, 4, half), fence, Enum.Material.Metal, folder)
	Util.makePart("FenceSideB", Vector3.new(Config.BaseSize, 6, 1), pos + Vector3.new(0, 4, -half), fence, Enum.Material.Metal, folder)

	local signAnchor = Util.makePart("SignAnchor", Vector3.new(1, 1, 1), pos + Vector3.new(0, 14, 0), Color3.new(1, 1, 1), nil, folder)
	signAnchor.Transparency = 1
	signAnchor.CanCollide = false
	base.SignLabel = Util.makeLabel(signAnchor, "", UDim2.fromOffset(140, 28), Vector3.new(0, 0, 0), 50)

	base.SpawnPos = pos + Vector3.new(frontDir * 8, 4, 8)

	local counter = Util.makePart("TradingShop", Vector3.new(3, 4, 10), pos + Vector3.new(frontDir * 9.5, 3, -13), Color3.fromRGB(150, 100, 60), Enum.Material.Wood, folder)
	Util.makeLabel(counter, "Trading Shop", UDim2.fromOffset(110, 28), Vector3.new(0, 3.5, 0), 40)
	buildTrader(folder, CFrame.new(pos + Vector3.new(frontDir * 14, 1, -13)) * CFrame.Angles(0, frontDir * Util.PI / 2, 0))

	local sell = Instance.new("ProximityPrompt")
	sell.ObjectText = "Trader"
	sell.ActionText = "Sell carried brainrot"
	sell.KeyboardKeyCode = Enum.KeyCode.E
	sell.HoldDuration = 0
	sell.MaxActivationDistance = 10
	sell.Parent = counter
	sell.Triggered:Connect(function(player) Bases.sellCarried(player) end)

	local tradeWith = Instance.new("ProximityPrompt")
	tradeWith.ObjectText = "Trader"
	tradeWith.ActionText = "Trade with players"
	tradeWith.KeyboardKeyCode = Enum.KeyCode.F
	tradeWith.HoldDuration = 0
	tradeWith.MaxActivationDistance = 10
	tradeWith.UIOffset = Vector2.new(0, 80)
	tradeWith.Parent = counter
	tradeWith.Triggered:Connect(function(player)
		local ev = ReplicatedStorage:FindFirstChild("TradeEvent")
		if ev then ev:FireClient(player, "OpenTrade") end
	end)

	for col = 1, 2 do
		for row = 1, 4 do
			local lx = frontDir * (col == 1 and -8 or -16)
			local lz = (row - 2.5) * 8
			local pad = Util.makePart("Pedestal", Vector3.new(6, 1, 6), pos + Vector3.new(lx, 1.5, lz), Color3.fromRGB(60, 60, 70), Enum.Material.Slate, folder)
			local label = Util.makeLabel(pad, "", UDim2.fromOffset(120, 36), Vector3.new(0, 7, 0), 40)
			label.Parent.Enabled = false

			local place = Instance.new("ProximityPrompt")
			place.ObjectText = "Pedestal"
			place.ActionText = "Place brainrot"
			place.KeyboardKeyCode = Enum.KeyCode.E
			place.HoldDuration = 0
			place.MaxActivationDistance = 7
			place.Parent = pad

			local pick = Instance.new("ProximityPrompt")
			pick.ActionText = "Pick up"
			pick.KeyboardKeyCode = Enum.KeyCode.E
			pick.HoldDuration = Config.PickupHold
			pick.MaxActivationDistance = 7
			pick.Enabled = false
			pick.Parent = pad

			local i = #base.Pedestals + 1
			base.Pedestals[i] = { Pad = pad, Label = label, Place = place, Pick = pick }
			place.Triggered:Connect(function(player) Bases.place(player, base, i) end)
			pick.Triggered:Connect(function(player) Bases.pickUp(player, base, i) end)
		end
	end

	Bases.updateSign(base)
	Bases.list[index] = base
	return base
end

function Bases.buildAll(map)
	Bases.map = map
	local count = 0
	for placeIndex, offset in ipairs(Config.PlaceOffsets) do
		for i = 1, Config.BasesPerPlace do
			count += 1
			Bases.buildOne(count, placeIndex, offset + Vector3.new(0, 0, (i - 2) * Config.BaseSpacing), map)
		end
	end
end

function Bases.assign(player)
	for _, base in ipairs(Bases.list) do
		if not base.Owner then
			base.Owner = player
			Bases.baseOf[player] = base
			Bases.updateSign(base)
			return base
		end
	end
	return nil
end

function Bases.release(player)
	Carry.drop(player)
	local base = Bases.baseOf[player]
	if base then
		for i = 1, #base.Pedestals do
			base.Slots[i] = nil
			Bases.refreshSlot(base, i)
		end
		base.Owner = nil
		Bases.baseOf[player] = nil
		Bases.updateSign(base)
	end
	Bases.stealCooldown[player] = nil
	Bases.stealProtectUntil[player] = nil
end

function Bases.applySavedSlots(player, savedSlots)
	local base = Bases.baseOf[player]
	if not base or typeof(savedSlots) ~= "table" then return end
	for i = 1, #base.Pedestals do
		local s = savedSlots[tostring(i)] or savedSlots[i]
		if typeof(s) == "table" and s.Id then
			local def = BrainrotDefs.GetById(s.Id)
			if def then
				base.Slots[i] = { Def = def, Super = s.Super == true }
				Bases.refreshSlot(base, i)
			end
		end
	end
end

function Bases.serializeSlots(player)
	local base = Bases.baseOf[player]
	local out = {}
	if not base then return out end
	for i = 1, #base.Pedestals do
		local slot = base.Slots[i]
		if slot then
			out[tostring(i)] = { Id = slot.Def.Id, Super = slot.Super == true }
		end
	end
	return out
end

function Bases.transferSlots(from, to, indices)
	local fromBase, toBase = Bases.baseOf[from], Bases.baseOf[to]
	if not (fromBase and toBase) then return false end
	if #indices < 1 then return false end
	if Bases.freeSlots(to) < #indices then return false end
	for _, i in ipairs(indices) do
		local slot = fromBase.Slots[i]
		if not slot then return false end
		local freeIndex = Bases.firstFreeSlot(toBase)
		if not freeIndex then return false end
		fromBase.Slots[i] = nil
		toBase.Slots[freeIndex] = slot
		Bases.refreshSlot(fromBase, i)
		Bases.refreshSlot(toBase, freeIndex)
	end
	return true
end

-- Legacy cheapest-N transfer for simple offers
function Bases.transferCheapest(from, to, n)
	local fromBase = Bases.baseOf[from]
	if not fromBase then return false end
	local owned = {}
	for i = 1, #fromBase.Pedestals do
		if fromBase.Slots[i] then table.insert(owned, i) end
	end
	table.sort(owned, function(a, b)
		return incomeOf(fromBase.Slots[a], from) < incomeOf(fromBase.Slots[b], from)
	end)
	if #owned < n then return false end
	local indices = {}
	for k = 1, n do table.insert(indices, owned[k]) end
	return Bases.transferSlots(from, to, indices)
end

function Bases.upgradeBest(player)
	local base = Bases.baseOf[player]
	if not base then return false end
	local best, bestIncome
	for i = 1, #base.Pedestals do
		local slot = base.Slots[i]
		if slot and not slot.Super and (not bestIncome or slot.Def.Income > bestIncome) then
			best, bestIncome = i, slot.Def.Income
		end
	end
	if not best then return false end
	base.Slots[best].Super = true
	Bases.refreshSlot(base, best)
	return true
end

function Bases.clearAllSlots(player)
	local base = Bases.baseOf[player]
	if not base then return end
	for i = 1, #base.Pedestals do
		base.Slots[i] = nil
		Bases.refreshSlot(base, i)
	end
end

function Bases.installApi()
	local api = Instance.new("BindableFunction")
	api.Name = "BaseApi"
	api.OnInvoke = function(action, a, b, c)
		if action == "Count" then return Bases.countOwned(a) end
		if action == "Free" then return Bases.freeSlots(a) end
		if action == "Transfer" then return Bases.transferCheapest(a, b, c) end
		if action == "TransferSlots" then return Bases.transferSlots(a, b, c) end
		if action == "IsCarrying" then return Carry.isCarrying(a) end
		if action == "ListSlots" then
			local base = Bases.baseOf[a]
			if not base then return {} end
			local list = {}
			for i = 1, #base.Pedestals do
				local slot = base.Slots[i]
				if slot then
					table.insert(list, { Index = i, Id = slot.Def.Id, Name = slot.Def.Name, Super = slot.Super, Income = incomeOf(slot, a) })
				end
			end
			return list
		end
	end
	api.Parent = ServerStorage
	return api
end

return Bases
]]></ProtectedString>
					<string name="Name">Bases</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(script.Parent.Util)

local BALL, BLOCK, CYL = Enum.PartType.Ball, Enum.PartType.Block, Enum.PartType.Cylinder
local V3 = Vector3.new
local PI = Util.PI
local GOLD = Util.GOLD

local function newPart(model, shape, size, cf, color, material, name)
	local p = Instance.new("Part")
	p.Name = name or "Piece"
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = true
	p.CanCollide = false
	p.Parent = model
	return p
end

local function addEyes(model, x, y, z, size)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, BALL, V3(size, size, size), CFrame.new(sx * x, y, z), Color3.new(1, 1, 1), nil, "Eye")
		newPart(model, BALL, V3(size * 0.5, size * 0.5, size * 0.5), CFrame.new(sx * x, y, z - size * 0.32), Color3.new(0.05, 0.05, 0.05), nil, "Eye")
	end
end

local STYLES = {}

STYLES.round = function(model, c)
	local light = c:Lerp(Color3.new(1, 1, 1), 0.45)
	local dark = c:Lerp(Color3.new(0, 0, 0), 0.3)
	newPart(model, BALL, V3(3.8, 3.8, 3.8), CFrame.new(0, 0, 0), c, nil, "Body")
	newPart(model, BALL, V3(2.4, 2.4, 1.2), CFrame.new(0, -0.5, -1.3), light)
	addEyes(model, 0.7, 0.7, -1.45, 1.2)
	newPart(model, BALL, V3(0.7, 0.7, 0.7), CFrame.new(0, 0.1, -1.9), Color3.fromRGB(255, 150, 40))
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, BALL, V3(1.2, 1.2, 1.2), CFrame.new(sx * 1.3, 1.6, 0.1), dark)
	end
	newPart(model, CYL, V3(1.4, 0.2, 0.2), CFrame.new(0, 2.5, 0) * CFrame.Angles(0, 0, PI / 2), dark)
	newPart(model, BALL, V3(0.6, 0.6, 0.6), CFrame.new(0, 3.3, 0), Color3.fromRGB(255, 70, 70))
end

STYLES.tall = function(model, c)
	local belly = Color3.fromRGB(235, 225, 205)
	local shoe = Color3.fromRGB(40, 120, 230)
	local sole = Color3.new(1, 1, 1)
	local dark = c:Lerp(Color3.new(0, 0, 0), 0.25)
	newPart(model, BALL, V3(3.2, 3.0, 5.2), CFrame.new(0, 0.4, 0), c, nil, "Body")
	newPart(model, BALL, V3(2.6, 2.2, 4.4), CFrame.new(0, -0.35, 0.1), belly)
	newPart(model, BALL, V3(1.15, 1.15, 1.15), CFrame.new(-1.35, 0.85, -1.4), Color3.new(1, 1, 1), nil, "Eye")
	newPart(model, BALL, V3(0.55, 0.55, 0.55), CFrame.new(-1.55, 0.85, -1.65), Color3.new(0.05, 0.05, 0.05), nil, "Eye")
	newPart(model, BLOCK, V3(0.35, 2.2, 1.4), CFrame.new(0, 1.6, 2.3) * CFrame.Angles(math.rad(-18), 0, 0), dark)
	newPart(model, BLOCK, V3(0.3, 1.4, 1.0), CFrame.new(0, 0.2, 2.9) * CFrame.Angles(math.rad(25), 0, 0), dark)
	newPart(model, BLOCK, V3(0.3, 1.1, 0.9), CFrame.new(0, -0.7, 2.55) * CFrame.Angles(math.rad(-30), 0, 0), dark)
	for _, xz in ipairs({ { -0.85, -1.1 }, { 0.85, -1.1 }, { -0.85, 1.15 }, { 0.85, 1.15 } }) do
		newPart(model, CYL, V3(1.1, 0.85, 0.85), CFrame.new(xz[1], -1.0, xz[2]) * CFrame.Angles(0, 0, PI / 2), c)
		newPart(model, BLOCK, V3(1.15, 0.55, 1.55), CFrame.new(xz[1], -1.75, xz[2] - 0.15), shoe)
		newPart(model, BLOCK, V3(1.2, 0.18, 1.65), CFrame.new(xz[1], -2.05, xz[2] - 0.15), sole)
		newPart(model, BLOCK, V3(0.35, 0.35, 0.7), CFrame.new(xz[1] + 0.35, -1.6, xz[2] - 0.15), sole)
	end
end

STYLES.leafy = function(model, c)
	local bark = Color3.fromRGB(150, 105, 60)
	local barkDark = Color3.fromRGB(100, 65, 35)
	local face = Color3.fromRGB(230, 195, 150)
	local beard = Color3.fromRGB(230, 230, 220)
	newPart(model, BALL, V3(3.4, 3.6, 2.8), CFrame.new(0, 0.9, 0), c, nil, "Body")
	newPart(model, BALL, V3(3.0, 2.8, 2.8), CFrame.new(0, 3.2, 0), c)
	newPart(model, BALL, V3(2.2, 2.0, 2.0), CFrame.new(0, 3.0, -0.55), face)
	newPart(model, BALL, V3(1.8, 1.0, 1.4), CFrame.new(0, 2.15, -0.5), beard)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, BALL, V3(1.0, 1.0, 0.7), CFrame.new(sx * 1.55, 3.7, 0.1), c)
	end
	addEyes(model, 0.55, 3.25, -1.35, 0.85)
	newPart(model, BLOCK, V3(0.7, 0.12, 0.1), CFrame.new(0, 2.55, -1.45), barkDark)
	newPart(model, CYL, V3(0.35, 2.4, 0.35), CFrame.new(-0.4, 1.0, -1.1) * CFrame.Angles(math.rad(15), 0, math.rad(20)), bark, Enum.Material.Wood)
	newPart(model, CYL, V3(0.3, 2.0, 0.3), CFrame.new(0.5, 0.7, -1.0) * CFrame.Angles(math.rad(-10), 0, math.rad(-25)), barkDark, Enum.Material.Wood)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, CYL, V3(2.4, 0.85, 0.85), CFrame.new(sx * 1.9, 1.1, 0) * CFrame.Angles(0, 0, math.rad(sx * 55)), bark, Enum.Material.Wood)
		newPart(model, BALL, V3(1.1, 1.1, 1.1), CFrame.new(sx * 1.5, 0.15, 0.4), bark, Enum.Material.Wood)
		newPart(model, CYL, V3(2.6, 1.0, 1.0), CFrame.new(sx * 0.75, -1.35, 0) * CFrame.Angles(0, 0, PI / 2), bark, Enum.Material.Wood)
		newPart(model, BLOCK, V3(1.3, 0.45, 1.9), CFrame.new(sx * 0.75, -2.55, -0.25), barkDark, Enum.Material.Wood)
		for t = -1, 1 do
			newPart(model, BLOCK, V3(0.28, 0.25, 0.55), CFrame.new(sx * 0.75 + t * 0.35, -2.55, -1.05), barkDark, Enum.Material.Wood)
		end
	end
end

STYLES.doodle = function(model, c)
	local dark = Color3.fromRGB(35, 30, 28)
	local shade = c:Lerp(Color3.new(0, 0, 0), 0.25)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, BLOCK, V3(0.9, 1.8, 0.9), CFrame.new(sx * 0.65, -1.0, 0), c, nil, "Leg")
	end
	newPart(model, BLOCK, V3(2.4, 2.2, 1.4), CFrame.new(0, 1.0, 0), c, nil, "Body")
	newPart(model, BLOCK, V3(2.4, 3.2, 2.0), CFrame.new(0, 3.7, 0), c)
	newPart(model, BLOCK, V3(2.2, 0.2, 1.8), CFrame.new(0, 5.4, 0), shade)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, BLOCK, V3(0.95, 0.95, 0.08), CFrame.new(sx * 0.6, 4.3, -1.01), dark, nil, "Eye")
		newPart(model, BLOCK, V3(0.75, 0.75, 0.08), CFrame.new(sx * 0.6, 4.3, -1.04), Color3.new(1, 1, 1), nil, "Eye")
		newPart(model, BLOCK, V3(0.3, 0.3, 0.08), CFrame.new(sx * 0.6, 4.3, -1.08), dark, nil, "Eye")
		newPart(model, BLOCK, V3(0.12, 0.4, 0.1), CFrame.new(sx * 1.0, 4.9, -1.02) * CFrame.Angles(0, 0, math.rad(-sx * 35)), dark)
	end
	newPart(model, BLOCK, V3(0.8, 0.14, 0.1), CFrame.new(0, 3.1, -1.02), dark)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, BLOCK, V3(0.5, 0.14, 0.1), CFrame.new(sx * 0.6, 3.25, -1.02) * CFrame.Angles(0, 0, math.rad(sx * 30)), dark)
	end
	newPart(model, BLOCK, V3(0.6, 2.2, 0.6), CFrame.new(1.7, 0.7, 0) * CFrame.Angles(0, 0, math.rad(15)), shade)
	newPart(model, CYL, V3(2.6, 0.8, 0.8), CFrame.new(2.3, -0.6, -0.3) * CFrame.Angles(0, 0, PI / 2), dark, Enum.Material.Wood)
	newPart(model, BALL, V3(0.8, 0.8, 0.8), CFrame.new(2.3, 0.7, -0.3), dark, Enum.Material.Wood)
	newPart(model, BLOCK, V3(2.2, 0.15, 1.3), CFrame.new(-2.2, 1.5, 0) * CFrame.Angles(0, 0, math.rad(20)), shade)
	newPart(model, BLOCK, V3(0.9, 0.15, 0.7), CFrame.new(-3.2, 1.1, 0) * CFrame.Angles(0, 0, math.rad(20)), shade)
end

-- starblast: capsule body, beak head, exploding star hair, two thick shoe legs
STYLES.starblast = function(model, c)
	local star = Color3.fromRGB(255, 200, 40)
	local beak = Color3.fromRGB(40, 40, 45)
	local shoe = Color3.fromRGB(30, 30, 35)
	newPart(model, BALL, V3(4.2, 2.6, 2.6), CFrame.new(0.3, 0.4, 0), c, nil, "Body")
	newPart(model, BALL, V3(1.8, 1.8, 1.8), CFrame.new(-1.8, 0.9, 0), c)
	newPart(model, BLOCK, V3(0.9, 0.7, 0.5), CFrame.new(-2.7, 0.55, -0.2) * CFrame.Angles(math.rad(20), 0, math.rad(-15)), beak)
	newPart(model, BALL, V3(0.55, 0.55, 0.55), CFrame.new(-2.05, 1.15, -0.75), Color3.new(1, 1, 1), nil, "Eye")
	newPart(model, BALL, V3(0.28, 0.28, 0.28), CFrame.new(-2.15, 1.15, -0.95), Color3.new(0.05, 0.05, 0.05), nil, "Eye")
	for a = 0, 7 do
		local ang = math.rad(a * 45)
		newPart(model, BLOCK, V3(0.35, 1.6, 0.25), CFrame.new(-1.8, 2.2, 0) * CFrame.Angles(0, 0, ang) * CFrame.new(0, 0.7, 0), star)
	end
	newPart(model, BALL, V3(0.9, 0.9, 0.9), CFrame.new(-1.8, 2.2, 0), star)
	for _, sx in ipairs({ -0.7, 0.9 }) do
		newPart(model, BLOCK, V3(0.9, 1.7, 0.9), CFrame.new(sx, -1.0, 0), c)
		newPart(model, BALL, V3(1.3, 0.7, 1.5), CFrame.new(sx, -1.95, -0.15), shoe)
	end
end

-- antenna: long capsule + round head with two antennae + fat shoe legs
STYLES.antenna = function(model, c)
	local dark = c:Lerp(Color3.new(0, 0, 0), 0.25)
	local shoe = Color3.fromRGB(50, 50, 60)
	newPart(model, BALL, V3(4.6, 2.4, 2.4), CFrame.new(0.2, 0.5, 0), c, nil, "Body")
	newPart(model, BALL, V3(2.0, 2.0, 2.0), CFrame.new(-2.0, 0.9, 0), c)
	newPart(model, BALL, V3(0.6, 0.6, 0.6), CFrame.new(-2.25, 1.15, -0.85), Color3.new(1, 1, 1), nil, "Eye")
	newPart(model, BALL, V3(0.3, 0.3, 0.3), CFrame.new(-2.35, 1.15, -1.05), Color3.new(0.05, 0.05, 0.05), nil, "Eye")
	for _, sx in ipairs({ -0.35, 0.35 }) do
		newPart(model, CYL, V3(1.2, 0.18, 0.18), CFrame.new(-2.0 + sx * 0.2, 2.0, 0) * CFrame.Angles(0, 0, math.rad(sx * 35) + PI / 2), dark)
		newPart(model, BALL, V3(0.45, 0.45, 0.45), CFrame.new(-2.0 + sx * 0.85, 2.55, 0), Color3.fromRGB(255, 90, 90))
	end
	for _, sx in ipairs({ -0.75, 0.95 }) do
		newPart(model, CYL, V3(1.5, 1.0, 1.0), CFrame.new(sx, -0.9, 0) * CFrame.Angles(0, 0, PI / 2), c)
		newPart(model, BALL, V3(1.5, 0.8, 1.7), CFrame.new(sx, -1.85, -0.1), shoe)
	end
end

-- catleg: chubby cat head/body with pointy ears and four zigzag stub legs
STYLES.catleg = function(model, c)
	local dark = Color3.fromRGB(40, 35, 35)
	local belly = c:Lerp(Color3.new(1, 1, 1), 0.35)
	newPart(model, BALL, V3(3.4, 2.6, 2.8), CFrame.new(0, 0.3, 0), c, nil, "Body")
	newPart(model, BALL, V3(2.8, 2.6, 2.6), CFrame.new(-0.2, 1.5, 0), c)
	newPart(model, BALL, V3(2.0, 1.6, 1.2), CFrame.new(-0.2, 1.2, -0.9), belly)
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, BLOCK, V3(0.7, 1.1, 0.35), CFrame.new(sx * 0.85, 2.7, 0.1) * CFrame.Angles(0, 0, math.rad(-sx * 18)), c)
	end
	addEyes(model, 0.55, 1.7, -1.2, 0.7)
	newPart(model, BLOCK, V3(0.6, 0.12, 0.1), CFrame.new(-0.15, 1.15, -1.35) * CFrame.Angles(0, 0, math.rad(12)), dark)
	for _, xz in ipairs({ { -0.9, -0.7 }, { 0.9, -0.7 }, { -0.9, 0.7 }, { 0.9, 0.7 } }) do
		newPart(model, BLOCK, V3(0.35, 0.9, 0.35), CFrame.new(xz[1], -1.0, xz[2]) * CFrame.Angles(0, 0, math.rad(xz[1] * 12)), dark)
		newPart(model, BLOCK, V3(0.35, 0.55, 0.35), CFrame.new(xz[1] * 1.15, -1.55, xz[2]) * CFrame.Angles(0, 0, math.rad(-xz[1] * 20)), dark)
	end
end

-- swordbox: boxy dual-sword fighter with mismatched eyes and scribbled mouth band
STYLES.swordbox = function(model, c)
	local dark = Color3.fromRGB(25, 25, 30)
	local steel = Color3.fromRGB(200, 210, 230)
	local shade = c:Lerp(Color3.new(0, 0, 0), 0.2)
	newPart(model, BLOCK, V3(2.8, 3.4, 1.6), CFrame.new(0, 1.2, 0), c, nil, "Body")
	newPart(model, BLOCK, V3(2.9, 0.9, 1.7), CFrame.new(0, 0.55, 0), dark) -- scribbled mouth/band
	newPart(model, BALL, V3(1.1, 1.1, 0.2), CFrame.new(-0.55, 2.15, -0.85), Color3.new(1, 1, 1), nil, "Eye")
	newPart(model, BALL, V3(0.85, 0.85, 0.2), CFrame.new(0.6, 2.35, -0.85), Color3.new(1, 1, 1), nil, "Eye")
	newPart(model, BALL, V3(0.4, 0.4, 0.15), CFrame.new(-0.55, 2.15, -0.95), dark, nil, "Eye")
	newPart(model, BALL, V3(0.3, 0.3, 0.15), CFrame.new(0.6, 2.35, -0.95), dark, nil, "Eye")
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, BLOCK, V3(0.45, 1.6, 0.45), CFrame.new(sx * 0.55, -0.9, 0), shade)
		newPart(model, BALL, V3(0.8, 0.45, 1.0), CFrame.new(sx * 0.55, -1.75, -0.1), dark)
		newPart(model, BLOCK, V3(0.35, 2.2, 0.35), CFrame.new(sx * 1.5, 2.4, 0) * CFrame.Angles(0, 0, math.rad(-sx * 25)), shade)
		newPart(model, BLOCK, V3(0.25, 3.2, 0.45), CFrame.new(sx * 1.85, 4.0, 0) * CFrame.Angles(0, 0, math.rad(-sx * 10)), steel)
		newPart(model, BLOCK, V3(0.55, 0.35, 0.55), CFrame.new(sx * 1.7, 2.35, 0), dark)
	end
end

-- flybeak: oval flying bird with big wings, pointed beak, whiskers
STYLES.flybeak = function(model, c)
	local beak = Color3.fromRGB(255, 160, 40)
	local wing = c:Lerp(Color3.new(1, 1, 1), 0.15)
	newPart(model, BALL, V3(4.0, 2.2, 2.4), CFrame.new(0, 0.8, 0), c, nil, "Body")
	newPart(model, BLOCK, V3(1.2, 0.55, 0.45), CFrame.new(-2.3, 0.85, 0) * CFrame.Angles(0, 0, math.rad(-10)), beak)
	newPart(model, BALL, V3(0.5, 0.5, 0.5), CFrame.new(-1.5, 1.2, -0.85), Color3.new(1, 1, 1), nil, "Eye")
	newPart(model, BALL, V3(0.25, 0.25, 0.25), CFrame.new(-1.6, 1.2, -1.0), Color3.new(0.05, 0.05, 0.05), nil, "Eye")
	for _, y in ipairs({ 0.5, 0.85, 1.2 }) do
		newPart(model, BLOCK, V3(0.7, 0.08, 0.08), CFrame.new(-2.5, y, 0.35) * CFrame.Angles(0, math.rad(20), math.rad((y - 0.85) * 40)), Color3.fromRGB(40, 40, 40))
	end
	for _, sx in ipairs({ -1, 1 }) do
		newPart(model, BALL, V3(2.6, 0.5, 1.8), CFrame.new(sx * 0.2, 1.1, sx * 1.4) * CFrame.Angles(math.rad(sx * 12), 0, math.rad(sx * 8)), wing)
	end
	newPart(model, BLOCK, V3(0.9, 0.35, 0.5), CFrame.new(2.0, 0.6, 0) * CFrame.Angles(0, 0, math.rad(15)), c)
end

local BrainrotModels = {}

function BrainrotModels.build(def, super)
	local customModels = ServerStorage:FindFirstChild("BrainrotModels")
	local model
	local template = customModels and customModels:FindFirstChild(def.Name)
	if template then
		model = template:Clone()
		if not model.PrimaryPart then
			model.PrimaryPart = model:FindFirstChildWhichIsA("BasePart", true)
		end
	else
		model = Instance.new("Model")
		local root = Instance.new("Part")
		root.Name = "Root"
		root.Size = V3(1, 1, 1)
		root.Transparency = 1
		root.CanCollide = false
		root.Anchored = true
		root.CFrame = CFrame.new()
		root.Parent = model
		model.PrimaryPart = root
		local styleFn = STYLES[def.Style or "round"] or STYLES.round
		styleFn(model, def.Color)
		if super then
			for _, d in ipairs(model:GetChildren()) do
				if d:IsA("BasePart") and d ~= root and d.Name ~= "Eye" then
					d.Color = GOLD
					d.Material = Enum.Material.Neon
				end
			end
		end
		local rare = def.Rarity == "Epic" or def.Rarity == "Legendary" or def.Rarity == "Mythic"
		if super or rare then
			local body = model:FindFirstChild("Body")
			if body then
				local sp = Instance.new("Sparkles")
				sp.SparkleColor = Util.rarityColor(def.Rarity)
				sp.Parent = body
			end
		end
	end
	model.Name = def.Name
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
	return model
end

function BrainrotModels.playSpawnPop(model)
	local root = model and model.PrimaryPart
	if not root then return end
	local goal = root.CFrame
	root.CFrame = goal * CFrame.new(0, 2, 0)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			d.Transparency = math.min(d.Transparency + 0.4, 0.85)
		end
	end
	task.spawn(function()
		local tw = TweenService:Create(root, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = goal })
		tw:Play()
		tw.Completed:Wait()
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "Root" then
				TweenService:Create(d, TweenInfo.new(0.2), { Transparency = 0 }):Play()
			end
		end
	end)
end

function BrainrotModels.startIdleBob(model)
	local root = model and model.PrimaryPart
	if not root then return end
	task.spawn(function()
		local base = root.CFrame
		local t0 = os.clock()
		while model.Parent and root.Parent do
			local t = os.clock() - t0
			root.CFrame = base * CFrame.new(0, math.sin(t * 2) * 0.12, 0)
			task.wait(0.03)
		end
	end)
end

return BrainrotModels
]]></ProtectedString>
					<string name="Name">BrainrotModels</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(script.Parent.Util)
local BrainrotModels = require(script.Parent.BrainrotModels)

local Carry = {
	_carrying = {}, -- [player] = { Slot, Model }
}

function Carry.get(player)
	return Carry._carrying[player]
end

function Carry.isCarrying(player)
	return Carry._carrying[player] ~= nil
end

function Carry.drop(player)
	local c = Carry._carrying[player]
	Carry._carrying[player] = nil
	if c and c.Model then
		c.Model:Destroy()
	end
end

function Carry.attach(player, slot)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	if Carry._carrying[player] then return false end

	local model = BrainrotModels.build(slot.Def, slot.Super)
	-- Held brainrots are shrunk so the player can see them; pedestals rebuild
	-- a fresh full-size model when the brainrot is placed.
	local scale = Config.CarryScale
	model:ScaleTo(scale)
	model.Parent = char
	-- hold it in front of the chest, slightly to the right
	model:PivotTo(hrp.CFrame * CFrame.new(1.3, 0.4, -2))

	local primary = model.PrimaryPart
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.Massless = true
			if d ~= primary then
				local w = Instance.new("WeldConstraint")
				w.Part0 = primary
				w.Part1 = d
				w.Parent = d
			end
		end
	end
	local w = Instance.new("WeldConstraint")
	w.Part0 = hrp
	w.Part1 = primary
	w.Parent = primary

	Util.makeLabel(primary, slot.Def.Name, UDim2.fromOffset(100, 28), Vector3.new(0, 4.5 * scale + 0.5, 0), 40, Util.rarityColor(slot.Def.Rarity))
	Carry._carrying[player] = { Slot = slot, Model = model }
	local remotes = require(ReplicatedStorage.Shared.Remotes)
	if remotes.GameEvent then
		remotes.GameEvent:FireClient(player, "Carry", slot.Def.Name)
	end
	return true
end

function Carry.clear(player)
	Carry.drop(player)
end

return Carry
]]></ProtectedString>
					<string name="Name">Carry</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {
	profiles = {}, -- [player] = data table
	_store = nil,
	_loadFailed = {}, -- [userId] = true — never overwrite on failed load
}

local function cloneDefault()
	local t = {
		Coins = Config.IsStudio and Config.StartCoins or 100,
		Rebirths = 0,
		LuckLevel = 0,
		Level = 1,
		Slots = {},
	}
	return t
end

function DataService.init()
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		DataService._store = store
	else
		warn("[DataService] DataStore unavailable: " .. tostring(store))
		DataService._store = nil
	end
end

local function keyFor(userId)
	return "p_" .. tostring(userId)
end

function DataService.load(player)
	local data = cloneDefault()
	if not DataService._store then
		DataService.profiles[player] = data
		return data, true
	end

	local ok, result
	for attempt = 1, 3 do
		ok, result = pcall(function()
			return DataService._store:GetAsync(keyFor(player.UserId))
		end)
		if ok then break end
		task.wait(0.5 * attempt)
	end

	if not ok then
		warn("[DataService] Load failed for " .. player.Name .. ": " .. tostring(result))
		DataService._loadFailed[player.UserId] = true
		DataService.profiles[player] = data
		return data, false
	end

	if typeof(result) == "table" then
		data.Coins = tonumber(result.Coins) or data.Coins
		data.Rebirths = tonumber(result.Rebirths) or 0
		data.LuckLevel = tonumber(result.LuckLevel) or 0
		data.Level = math.clamp(math.floor(tonumber(result.Level) or 1), 1, Config.MaxLevel)
		data.Slots = typeof(result.Slots) == "table" and result.Slots or {}
	end
	DataService.profiles[player] = data
	DataService._loadFailed[player.UserId] = nil
	return data, true
end

function DataService.get(player)
	return DataService.profiles[player]
end

function DataService.save(player)
	local data = DataService.profiles[player]
	if not data then return false end
	if DataService._loadFailed[player.UserId] then
		warn("[DataService] Skipping save for " .. player.Name .. " (previous load failed)")
		return false
	end
	if not DataService._store then
		return true -- Studio / unpublished: treat as ok
	end
	local ok, err = pcall(function()
		DataService._store:SetAsync(keyFor(player.UserId), data)
	end)
	if not ok then
		warn("[DataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

function DataService.release(player)
	DataService.save(player)
	DataService.profiles[player] = nil
	DataService._loadFailed[player.UserId] = nil
end

function DataService.startAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				pcall(function() DataService.save(player) end)
			end
		end
	end)
end

function DataService.bindToClose()
	game:BindToClose(function()
		for _, player in ipairs(Players:GetPlayers()) do
			pcall(function() DataService.save(player) end)
		end
		task.wait(2)
	end)
end

return DataService
]]></ProtectedString>
					<string name="Name">DataService</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Util = require(script.Parent.Util)
local Bases = require(script.Parent.Bases)
local DataService = require(script.Parent.DataService)

local Economy = {}

function Economy.startIncomeLoop()
	local remotes = require(ReplicatedStorage.Shared.Remotes)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, base in ipairs(Bases.list) do
				local owner = base.Owner
				if owner then
					local total = Bases.totalIncome(owner)
					if total > 0 then
						local coins = Util.getStat(owner, "Coins")
						if coins then
							coins.Value += total
							local data = DataService.get(owner)
							if data then data.Coins = coins.Value end
						end
						local incomeStat = Util.getStat(owner, "Income")
						if incomeStat then incomeStat.Value = total end
						if remotes.IncomeUpdate then
							remotes.IncomeUpdate:FireClient(owner, total)
						end
					end
				end
			end
		end
	end)
end

return Economy
]]></ProtectedString>
					<string name="Name">Economy</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX9">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local BrainrotDefs = require(ReplicatedStorage.Shared.BrainrotDefs)
local Util = require(script.Parent.Util)
local Bases = require(script.Parent.Bases)
local Carry = require(script.Parent.Carry)
local DataService = require(script.Parent.DataService)
local RateLimit = require(script.Parent.RateLimit)

local PlayersService = {}

local function teleportToBase(player, char)
	local base = Bases.baseOf[player]
	if not base then return end
	char:WaitForChild("HumanoidRootPart", 5)
	task.wait()
	pcall(function()
		char:PivotTo(CFrame.new(base.SpawnPos))
	end)
end

local function syncProfileFromLive(player)
	local data = DataService.get(player)
	if not data then return end
	local coins = Util.getStat(player, "Coins")
	if coins then data.Coins = coins.Value end
	data.Slots = Bases.serializeSlots(player)
end

function PlayersService.setup(player)
	if player:FindFirstChild("leaderstats") then
		return
	end

	local data, loadedOk = DataService.load(player)

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"

	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = data.Coins or Config.StartCoins
	coins.Parent = stats

	local brainrots = Instance.new("IntValue")
	brainrots.Name = "Brainrots"
	brainrots.Value = 0
	brainrots.Parent = stats

	local income = Instance.new("IntValue")
	income.Name = "Income"
	income.Value = 0
	income.Parent = stats

	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Value = data.Level or 1
	level.Parent = stats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = data.Rebirths or 0
	rebirths.Parent = stats

	stats.Parent = player

	coins:GetPropertyChangedSignal("Value"):Connect(function()
		local d = DataService.get(player)
		if d then d.Coins = coins.Value end
	end)

	local base = Bases.assign(player)
	if not base then
		Util.notify(player, "Server is full - no free base!")
		return
	end

	Bases.applySavedSlots(player, data.Slots)

	local hasAny = Bases.countOwned(player) > 0
	if not hasAny and Config.StudioGiveStarterBrainrot then
		base.Slots[1] = { Def = BrainrotDefs[1], Super = false }
		Bases.refreshSlot(base, 1)
	end

	Bases.onChanged = Bases.onChanged or function(p)
		syncProfileFromLive(p)
	end

	player.CharacterAdded:Connect(function(char)
		teleportToBase(player, char)
	end)
	player.CharacterRemoving:Connect(function()
		Bases.returnCarry(player)
		syncProfileFromLive(player)
	end)
	if player.Character then
		task.spawn(teleportToBase, player, player.Character)
	end

	local msg = ("Welcome! %d coins | Level %d"):format(coins.Value, data.Level or 1)
	if (data.Rebirths or 0) > 0 then
		msg ..= (" | Rebirths: %d"):format(data.Rebirths)
	end
	if not loadedOk then
		msg ..= " (save load failed — progress may not persist this session)"
	end
	Util.notify(player, msg)
end

function PlayersService.remove(player)
	syncProfileFromLive(player)
	DataService.release(player)
	Bases.release(player)
	RateLimit.clear(player)
	Carry.clear(player)
end

function PlayersService.start()
	Bases.onChanged = function(player)
		syncProfileFromLive(player)
	end

	Players.PlayerAdded:Connect(function(player)
		Util.safe("setupPlayer " .. player.Name, function()
			PlayersService.setup(player)
		end)
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			Util.safe("setupPlayer " .. p.Name, function()
				PlayersService.setup(p)
			end)
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		Util.safe("removePlayer " .. player.Name, function()
			PlayersService.remove(player)
		end)
	end)
end

return PlayersService
]]></ProtectedString>
					<string name="Name">PlayersService</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX10">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(script.Parent.Util)
local Bases = require(script.Parent.Bases)
local Carry = require(script.Parent.Carry)
local DataService = require(script.Parent.DataService)
local RateLimit = require(script.Parent.RateLimit)

local Progress = {}

-- Spend coins to raise the player level (1 to Config.MaxLevel).
-- amount: a number of levels to buy, or "max" to buy as many as affordable.
function Progress.upgradeLevel(player, amount)
	if not RateLimit.allow(player, "level", 0.1) then return end
	local data = DataService.get(player)
	local coins = Util.getStat(player, "Coins")
	if not (data and coins) then return end

	if amount == "max" then
		amount = Config.MaxLevel
	elseif typeof(amount) == "number" then
		amount = math.clamp(math.floor(amount), 1, 100)
	else
		return
	end

	local level = data.Level or 1
	if level >= Config.MaxLevel then
		Util.notify(player, "You are already at max level (" .. Config.MaxLevel .. ").")
		return
	end

	local target = math.min(Config.MaxLevel, level + amount)
	local newLevel, spent = level, 0
	while newLevel < target do
		local cost = Config.LevelCost(newLevel)
		if coins.Value - spent < cost then break end
		spent += cost
		newLevel += 1
	end

	if newLevel == level then
		Util.notify(player, ("Not enough coins. Level %d costs %d."):format(level + 1, Config.LevelCost(level)))
		return
	end

	coins.Value -= spent
	data.Coins = coins.Value
	data.Level = newLevel
	local levelStat = Util.getStat(player, "Level")
	if levelStat then levelStat.Value = newLevel end
	Bases.refreshLabels(player)
	Util.notify(player, ("Level %d! Income x%.2f"):format(newLevel, Config.LevelIncomeMultiplier(newLevel)))
end

function Progress.tryRebirth(player)
	if not RateLimit.allow(player, "rebirth", 2) then return end
	if Carry.isCarrying(player) then
		Util.notify(player, "Place your carried brainrot before rebirthing.")
		return
	end
	local data = DataService.get(player)
	if not data then return end
	local income = Bases.totalIncome(player)
	if income < Config.RebirthMinIncome then
		Util.notify(player, ("Need %d income/s to rebirth (you have %d)."):format(Config.RebirthMinIncome, income))
		return
	end
	Bases.clearAllSlots(player)
	local coins = Util.getStat(player, "Coins")
	if coins then
		coins.Value = Config.IsStudio and Config.StartCoins or 100
		data.Coins = coins.Value
	end
	data.Rebirths = (data.Rebirths or 0) + 1
	data.LuckLevel = (data.LuckLevel or 0) + 1
	data.Slots = {}
	local rebirthStat = Util.getStat(player, "Rebirths")
	if rebirthStat then rebirthStat.Value = data.Rebirths end
	local pct = math.floor(Config.RebirthIncomeBonus * 100 * data.Rebirths)
	Util.notify(player, ("Rebirth #%d! Permanent +%d%% income. Luck +1."):format(data.Rebirths, pct))
	DataService.save(player)
end

function Progress.start()
	local remotes = require(ReplicatedStorage.Shared.Remotes)
	if remotes.GameEvent then
		remotes.GameEvent.OnServerEvent:Connect(function(player, action, a)
			if action == "UpgradeLevel" then
				Progress.upgradeLevel(player, a)
			end
		end)
	end
end

return Progress
]]></ProtectedString>
					<string name="Name">Progress</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local last = {} -- [player] = {[key]=clock}

local RateLimit = {}

function RateLimit.allow(player, key, seconds)
	seconds = seconds or Config.RemoteRateLimitSeconds
	if not player then return false end
	last[player] = last[player] or {}
	local t = os.clock()
	local prev = last[player][key] or -999
	if t - prev < seconds then
		return false
	end
	last[player][key] = t
	return true
end

function RateLimit.clear(player)
	last[player] = nil
end

return RateLimit
]]></ProtectedString>
					<string name="Name">RateLimit</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX12">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local BrainrotDefs = require(ReplicatedStorage.Shared.BrainrotDefs)
local Util = require(script.Parent.Util)
local Bases = require(script.Parent.Bases)
local RateLimit = require(script.Parent.RateLimit)

local Shop = {}

function Shop.buildShowcase(map)
	local folder = Instance.new("Folder")
	folder.Name = "BrainrotShowcase"
	folder.Parent = map

	local platform = Util.makePart("ShowcasePad", Vector3.new(36, 1, 10), Vector3.new(0, 0.5, 55), Color3.fromRGB(45, 45, 55), Enum.Material.Slate, folder)
	Util.makeLabel(platform, "Showcase", UDim2.fromOffset(100, 24), Vector3.new(0, 5, 0), 30)

	-- Showcase a mix including the newest sketch-based brainrots
	local BrainrotModels = require(script.Parent.BrainrotModels)
	local showcaseIds = { "gattini", "antennini", "volanti", "stellina", "spadino", "tralalero" }
	for i, id in ipairs(showcaseIds) do
		local def = BrainrotDefs.GetById(id) or BrainrotDefs[i]
		local x = (i - 3.5) * 5.5
		local ped = Util.makePart("Showcase_" .. def.Id, Vector3.new(4, 1, 4), Vector3.new(x, 1.5, 55), Color3.fromRGB(70, 70, 80), Enum.Material.Slate, folder)
		local m = BrainrotModels.build(def, false)
		m.Parent = folder
		m:PivotTo(CFrame.new(ped.Position + Vector3.new(0, 0.5 + Util.footOf(def), 0)) * CFrame.Angles(0, Util.PI, 0))
		Util.makeLabel(m.PrimaryPart, def.Name .. "\n" .. def.Rarity, UDim2.fromOffset(100, 32), Vector3.new(0, 5, 0), 25, Util.rarityColor(def.Rarity))
	end

end

function Shop.buildSuperStand(map)
	local stand = Util.makePart("SuperUpgradeStand", Vector3.new(10, 5, 3), Vector3.new(0, 2.5, 60), Util.GOLD, Enum.Material.Neon, map)
	Util.makeLabel(stand, ("Super Upgrade\nR$ %d"):format(Config.SuperUpgradePriceRobux), UDim2.fromOffset(110, 32), Vector3.new(0, 4, 0), 30)

	local superPrompt = Instance.new("ProximityPrompt")
	superPrompt.ObjectText = "Super Upgrade Brainrot"
	superPrompt.ActionText = ("Buy for %d Robux"):format(Config.SuperUpgradePriceRobux)
	superPrompt.KeyboardKeyCode = Enum.KeyCode.E
	superPrompt.HoldDuration = 0
	superPrompt.MaxActivationDistance = 12
	superPrompt.Parent = stand

	superPrompt.Triggered:Connect(function(player)
		if not RateLimit.allow(player, "super", 1) then return end
		local base = Bases.baseOf[player]
		local hasOne = false
		if base then
			for i = 1, #base.Pedestals do
				if base.Slots[i] and not base.Slots[i].Super then hasOne = true end
			end
		end
		if not hasOne then
			Util.notify(player, "Place a brainrot in your base first - upgrade applies to your best one!")
			return
		end

		if Config.SuperUpgradeProductId == 0 then
			if Config.StudioFreeSuperUpgrade and Config.IsStudio then
				if Bases.upgradeBest(player) then
					Util.notify(player, ("Super Upgrade! x%d income (Studio test)"):format(Config.SuperMultiplier))
				end
			else
				Util.notify(player, "Robux shop not configured yet. Set SuperUpgradeProductId in Config.")
			end
			return
		end

		MarketplaceService:PromptProductPurchase(player, Config.SuperUpgradeProductId)
	end)

	local okStore, receipts = pcall(function()
		return DataStoreService:GetDataStore(Config.ReceiptStoreName)
	end)
	if not okStore then
		warn("[Shop] Receipt store unavailable: " .. tostring(receipts))
		receipts = {
			GetAsync = function() error("unavailable") end,
			SetAsync = function() error("unavailable") end,
		}
	end

	MarketplaceService.ProcessReceipt = function(info)
		if info.ProductId ~= Config.SuperUpgradeProductId or Config.SuperUpgradeProductId == 0 then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local player = Players:GetPlayerByUserId(info.PlayerId)
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local key = info.PlayerId .. "_" .. info.PurchaseId
		local ok, already = pcall(function() return receipts:GetAsync(key) end)
		if ok and already then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		if not ok and not RunService:IsStudio() then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if not Bases.upgradeBest(player) then
			Util.notify(player, "No brainrot to upgrade yet. We'll retry when you have one.")
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		pcall(function() receipts:SetAsync(key, true) end)
		Util.notify(player, ("Super Upgrade! Your best brainrot now earns x%d!"):format(Config.SuperMultiplier))
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

function Shop.buildRebirthPad(map)
	local pad = Util.makePart("RebirthPad", Vector3.new(6, 1.5, 6), Vector3.new(-12, 1.25, 48), Color3.fromRGB(200, 80, 220), Enum.Material.Neon, map)
	Util.makeLabel(pad, "REBIRTH\nE = reset+", UDim2.fromOffset(100, 32), Vector3.new(0, 3, 0), 30)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ObjectText = "Rebirth"
	prompt.ActionText = "Rebirth for income bonus"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 1
	prompt.MaxActivationDistance = 12
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		local Progress = require(script.Parent.Progress)
		Progress.tryRebirth(player)
	end)
end

return Shop
]]></ProtectedString>
					<string name="Name">Shop</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX13">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local BrainrotDefs = require(ReplicatedStorage.Shared.BrainrotDefs)
local Util = require(script.Parent.Util)
local BrainrotModels = require(script.Parent.BrainrotModels)
local Carry = require(script.Parent.Carry)
local Bases = require(script.Parent.Bases)
local DataService = require(script.Parent.DataService)
local RateLimit = require(script.Parent.RateLimit)

local Track = {}

function Track.start(map)
	local L = Config.TrackHalfLength
	Util.makePart("Track", Vector3.new(L * 2, 0.4, 8), Vector3.new(0, 0.2, 0), Color3.fromRGB(40, 40, 45), Enum.Material.Metal, map)

	local function spawnRunner()
		local luck = 0
		-- average luck of online players slightly affects spawn (simple)
		local DataService = require(script.Parent.DataService)
		local n = 0
		for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
			local d = DataService.get(plr)
			if d then
				luck += (d.LuckLevel or 0)
				n += 1
			end
		end
		if n > 0 then luck = luck / n * 0.15 end

		local def = BrainrotDefs.PickWeighted(luck)
		local model = BrainrotModels.build(def, false)
		model.Parent = map
		local face = CFrame.Angles(0, -Util.PI / 2, 0)
		local trackY = 0.4 + Util.footOf(def)
		model:PivotTo(CFrame.new(-L, trackY, 0) * face)

		local root = model.PrimaryPart
		local color = Util.rarityColor(def.Rarity)
		Util.makeLabel(root, ("%s\n%d | +%d/s"):format(def.Name, def.Price, def.Income), UDim2.fromOffset(120, 36), Vector3.new(0, 5, 0), 28, color)

		local buy = Instance.new("ProximityPrompt")
		buy.ObjectText = def.Name
		buy.ActionText = ("Buy & carry (%d)"):format(def.Price)
		buy.KeyboardKeyCode = Enum.KeyCode.E
		buy.HoldDuration = 0
		buy.MaxActivationDistance = 10
		buy.Parent = root

		local sold = false
		buy.Triggered:Connect(function(player)
			if sold then return end
			if not RateLimit.allow(player, "buy", 0.4) then return end
			local coins = Util.getStat(player, "Coins")
			if not coins then return end
			if not Bases.baseOf[player] then
				Util.notify(player, "You don't have a base.")
				return
			end
			if Carry.isCarrying(player) then
				Util.notify(player, "You're already carrying a brainrot.")
				return
			end
			if coins.Value < def.Price then
				Util.notify(player, "Not enough coins.")
				return
			end
			if not Carry.attach(player, { Def = def, Super = false }) then return end
			sold = true
			coins.Value -= def.Price
			local data = DataService.get(player)
			if data then data.Coins = coins.Value end
			Util.notify(player, "Bought " .. def.Name .. "! Carry it to a pedestal.")
			model:Destroy()
		end)

		task.spawn(function()
			local duration = (L * 2) / Config.TrackSpeed
			local t = 0
			while model.Parent and t < duration do
				t += RunService.Heartbeat:Wait()
				if model.Parent then
					-- single writer for position (bob is folded in here so it can't fight the movement)
					local x = -L + (L * 2) * math.min(t / duration, 1)
					local bob = math.sin(t * 2) * 0.12
					model:PivotTo(CFrame.new(x, trackY + bob, 0) * face)
				end
			end
			if model.Parent then model:Destroy() end
		end)
	end

	task.spawn(function()
		while true do
			Util.safe("spawnRunner", spawnRunner)
			task.wait(Config.SpawnInterval)
		end
	end)
end

return Track
]]></ProtectedString>
					<string name="Name">Track</string>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX14">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local Util = {}
Util.GOLD = Color3.fromRGB(255, 200, 40)
Util.PI = math.pi
Util.DEFAULT_FOOT = 1.9

function Util.safe(label, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[TradeBrainrot] " .. tostring(label) .. ": " .. tostring(err))
	end
	return ok, err
end

function Util.footOf(def)
	return (def and def.Foot) or Util.DEFAULT_FOOT
end

function Util.makePart(name, size, position, color, material, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = position
	p.Anchored = true
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function Util.makeLabel(parent, text, size, offset, maxDistance, textColor)
	local gui = Instance.new("BillboardGui")
	gui.Size = size or UDim2.fromOffset(110, 32)
	gui.StudsOffset = offset or Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = maxDistance or 35
	gui.Parent = parent
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = textColor or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Text = text
	label.Parent = gui
	local cap = Instance.new("UITextSizeConstraint")
	cap.MaxTextSize = 14
	cap.MinTextSize = 8
	cap.Parent = label
	return label
end

function Util.getStat(player, name)
	local stats = player and player:FindFirstChild("leaderstats")
	return stats and stats:FindFirstChild(name)
end

function Util.notify(player, message)
	local ev = ReplicatedStorage:FindFirstChild("TradeEvent")
	if ev and player and player.Parent == Players then
		ev:FireClient(player, "Message", message)
	end
end

function Util.incomeOf(slot, rebirths, level)
	if not slot or not slot.Def then return 0 end
	local mult = (slot.Super and Config.SuperMultiplier or 1)
	local rebirthMult = 1 + (rebirths or 0) * Config.RebirthIncomeBonus
	local levelMult = Config.LevelIncomeMultiplier(level or 1)
	return math.max(1, math.floor(slot.Def.Income * mult * rebirthMult * levelMult))
end

function Util.rarityColor(rarity)
	return Config.RarityColors[rarity] or Color3.new(1, 1, 1)
end

return Util
]]></ProtectedString>
					<string name="Name">Util</string>
				</Properties>
			</Item>
			</Item>
	</Item>
	<Item class="ServerStorage" referent="RBX23">
		<Properties>
			<string name="Name">ServerStorage</string>
		</Properties>
	</Item>
	<Item class="StarterPlayer" referent="RBX24">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX25">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX19">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Client HUD: coins, income, carry status, trade UI (responsive + mobile-friendly)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local event = ReplicatedStorage:WaitForChild("TradeEvent")
local remotesFolder = ReplicatedStorage:WaitForChild("GameRemotes", 10)
local incomeEvent = remotesFolder and remotesFolder:WaitForChild("IncomeUpdate", 10)
local gameEvent = remotesFolder and remotesFolder:WaitForChild("GameEvent", 10)

local gui = Instance.new("ScreenGui")
gui.Name = "TradeGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local scale = Instance.new("UIScale")
scale.Parent = gui
local function refreshScale()
	local cam = workspace.CurrentCamera
	local size = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local s = math.clamp(math.min(size.X, size.Y) / 900, 0.75, 1.25)
	if isMobile then s = math.clamp(s * 1.1, 0.85, 1.35) end
	scale.Scale = s
end
refreshScale()
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScale)
end

local function make(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do obj[k] = v end
	obj.Parent = parent
	return obj
end

local function corner(obj, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, obj)
end

-- Top HUD panel
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local hud = make("Frame", {
	Size = UDim2.fromOffset(280, 156),
	Position = UDim2.new(0.5, -140, 0, 12),
	BackgroundColor3 = Color3.fromRGB(25, 25, 35),
	BackgroundTransparency = 0.15,
}, gui)
corner(hud, 12)
make("UIStroke", { Color = Color3.fromRGB(255, 200, 60), Thickness = 1.5, Transparency = 0.4 }, hud)

local coinsBar = make("TextLabel", {
	Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, 8),
	BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 215, 70),
	Font = Enum.Font.GothamBold, TextSize = 22, Text = "Coins: …", TextXAlignment = Enum.TextXAlignment.Left,
}, hud)

local incomeBar = make("TextLabel", {
	Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 40),
	BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(140, 255, 160),
	Font = Enum.Font.GothamMedium, TextSize = 16, Text = "Income: 0/s", TextXAlignment = Enum.TextXAlignment.Left,
}, hud)

local carryBar = make("TextLabel", {
	Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 66),
	BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(180, 200, 255),
	Font = Enum.Font.Gotham, TextSize = 14, Text = "Carrying: none", TextXAlignment = Enum.TextXAlignment.Left,
}, hud)

local levelBar = make("TextLabel", {
	Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 88),
	BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 190, 255),
	Font = Enum.Font.GothamBold, TextSize = 14, Text = "Level 1 / " .. Config.MaxLevel,
	TextXAlignment = Enum.TextXAlignment.Left,
}, hud)

local function makeUpgradeButton(text, xOffset, width, amount)
	local btn = make("TextButton", {
		Size = UDim2.fromOffset(width, 30), Position = UDim2.fromOffset(xOffset, 116),
		Text = text, Font = Enum.Font.GothamBold, TextSize = 13,
		BackgroundColor3 = Color3.fromRGB(150, 80, 210), TextColor3 = Color3.new(1, 1, 1),
	}, hud)
	corner(btn, 8)
	btn.MouseButton1Click:Connect(function()
		if gameEvent then gameEvent:FireServer("UpgradeLevel", amount) end
	end)
	return btn
end
local upgrade1 = makeUpgradeButton("Level Up", 8, 112, 1)
makeUpgradeButton("+10", 126, 62, 10)
makeUpgradeButton("Max", 194, 78, "max")

task.spawn(function()
	local stats = player:WaitForChild("leaderstats", 30)
	if not stats then
		coinsBar.Text = "Coins: (waiting…)"
		return
	end
	local coins = stats:WaitForChild("Coins", 10)
	local income = stats:FindFirstChild("Income") or stats:WaitForChild("Income", 5)
	local level = stats:FindFirstChild("Level") or stats:WaitForChild("Level", 5)
	local function updateCoins()
		if coins then coinsBar.Text = "Coins: " .. tostring(coins.Value) end
	end
	local function updateIncome()
		if income then incomeBar.Text = "Income: " .. tostring(income.Value) .. "/s" end
	end
	local function updateLevel()
		if not level then return end
		local lv = level.Value
		if lv >= Config.MaxLevel then
			levelBar.Text = "Level " .. lv .. " / " .. Config.MaxLevel .. " (MAX)"
			upgrade1.Text = "MAX"
		else
			levelBar.Text = ("Level %d / %d  |  next: %d"):format(lv, Config.MaxLevel, Config.LevelCost(lv))
			upgrade1.Text = "Level Up"
		end
	end
	updateCoins()
	updateIncome()
	updateLevel()
	if coins then coins:GetPropertyChangedSignal("Value"):Connect(updateCoins) end
	if income then income:GetPropertyChangedSignal("Value"):Connect(updateIncome) end
	if level then level:GetPropertyChangedSignal("Value"):Connect(updateLevel) end
end)

if incomeEvent then
	incomeEvent.OnClientEvent:Connect(function(total)
		incomeBar.Text = "Income: " .. tostring(total) .. "/s"
	end)
end
if gameEvent then
	gameEvent.OnClientEvent:Connect(function(action, a)
		if action == "Carry" then
			carryBar.Text = a and ("Carrying: " .. tostring(a)) or "Carrying: none"
		end
	end)
end

-- Trade button
local openBtn = make("TextButton", {
	Size = UDim2.fromOffset(110, 44), Position = UDim2.new(0, 12, 0.5, -22),
	Text = "Trade", Font = Enum.Font.GothamBold, TextSize = 18,
	BackgroundColor3 = Color3.fromRGB(60, 120, 220), TextColor3 = Color3.new(1, 1, 1),
	AutoButtonColor = true,
}, gui)
corner(openBtn, 10)

local frame = make("Frame", {
	Size = UDim2.fromOffset(300, 380), Position = UDim2.new(0, 130, 0.5, -120),
	BackgroundColor3 = Color3.fromRGB(30, 30, 42), Visible = false,
}, gui)
corner(frame, 12)

make("TextLabel", {
	Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, Text = "Trade with a player",
	Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Color3.new(1, 1, 1),
}, frame)

local giveBox = make("TextBox", {
	Size = UDim2.fromOffset(130, 32), Position = UDim2.fromOffset(12, 40),
	PlaceholderText = "Brainrots to give", Text = "1", Font = Enum.Font.Gotham, TextSize = 14,
	BackgroundColor3 = Color3.fromRGB(55, 55, 70), TextColor3 = Color3.new(1, 1, 1),
}, frame)
corner(giveBox)

local wantBox = make("TextBox", {
	Size = UDim2.fromOffset(130, 32), Position = UDim2.fromOffset(158, 40),
	PlaceholderText = "Coins you want", Text = "10", Font = Enum.Font.Gotham, TextSize = 14,
	BackgroundColor3 = Color3.fromRGB(55, 55, 70), TextColor3 = Color3.new(1, 1, 1),
}, frame)
corner(wantBox)

local hint = make("TextLabel", {
	Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 76),
	BackgroundTransparency = 1, Text = "Offers expire in 30s. Cheapest brainrots transfer unless you select slots below.",
	Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true, TextColor3 = Color3.fromRGB(180, 180, 200),
}, frame)

local slotList = make("ScrollingFrame", {
	Size = UDim2.new(1, -20, 0, 80), Position = UDim2.fromOffset(10, 112),
	BackgroundColor3 = Color3.fromRGB(40, 40, 55), BorderSizePixel = 0,
	CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 5,
}, frame)
corner(slotList)
make("UIListLayout", { Padding = UDim.new(0, 3) }, slotList)

local selected = {} -- [index]=true

local function refreshSlots(list)
	for _, child in ipairs(slotList:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	selected = {}
	if typeof(list) ~= "table" then return end
	for _, info in ipairs(list) do
		local btn = make("TextButton", {
			Size = UDim2.new(1, -6, 0, 26),
			Text = string.format("[%d] %s%s  +%d/s", info.Index, info.Name, info.Super and " ★" or "", info.Income or 0),
			Font = Enum.Font.Gotham, TextSize = 12,
			BackgroundColor3 = Color3.fromRGB(60, 60, 80), TextColor3 = Color3.new(1, 1, 1),
			TextXAlignment = Enum.TextXAlignment.Left,
		}, slotList)
		corner(btn, 6)
		local pad = make("UIPadding", {}, btn)
		pad.PaddingLeft = UDim.new(0, 6)
		btn.MouseButton1Click:Connect(function()
			if selected[info.Index] then
				selected[info.Index] = nil
				btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
			else
				selected[info.Index] = true
				btn.BackgroundColor3 = Color3.fromRGB(80, 140, 90)
			end
		end)
	end
end

local list = make("ScrollingFrame", {
	Size = UDim2.new(1, -20, 1, -210), Position = UDim2.fromOffset(10, 200),
	BackgroundColor3 = Color3.fromRGB(40, 40, 55), BorderSizePixel = 0,
	CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6,
}, frame)
corner(list)
make("UIListLayout", { Padding = UDim.new(0, 4) }, list)

local function selectedIndices()
	local out = {}
	for idx in pairs(selected) do table.insert(out, idx) end
	table.sort(out)
	return out
end

local function refreshList()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local btn = make("TextButton", {
				Size = UDim2.new(1, -6, 0, 34), Text = "Offer to " .. other.DisplayName,
				Font = Enum.Font.GothamBold, TextSize = 14,
				BackgroundColor3 = Color3.fromRGB(70, 150, 85), TextColor3 = Color3.new(1, 1, 1),
			}, list)
			corner(btn)
			btn.MouseButton1Click:Connect(function()
				local idxs = selectedIndices()
				local give = tonumber(giveBox.Text) or 1
				if #idxs > 0 then give = #idxs end
				event:FireServer("Offer", other.UserId, give, tonumber(wantBox.Text), #idxs > 0 and idxs or nil)
			end)
		end
	end
end

openBtn.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
	if frame.Visible then
		refreshList()
		event:FireServer("ListMySlots")
	end
end)
Players.PlayerAdded:Connect(function() if frame.Visible then refreshList() end end)
Players.PlayerRemoving:Connect(function() task.defer(function() if frame.Visible then refreshList() end end) end)

local popup = make("Frame", {
	Size = UDim2.fromOffset(320, 140), Position = UDim2.new(0.5, -160, 0, 120),
	BackgroundColor3 = Color3.fromRGB(30, 30, 42), Visible = false,
}, gui)
corner(popup, 12)

local popupText = make("TextLabel", {
	Size = UDim2.new(1, -20, 0, 70), Position = UDim2.fromOffset(10, 8), BackgroundTransparency = 1,
	Font = Enum.Font.Gotham, TextSize = 15, TextWrapped = true, TextColor3 = Color3.new(1, 1, 1), Text = "",
}, popup)

local acceptBtn = make("TextButton", {
	Size = UDim2.fromOffset(140, 40), Position = UDim2.fromOffset(12, 88), Text = "Accept",
	Font = Enum.Font.GothamBold, TextSize = 16,
	BackgroundColor3 = Color3.fromRGB(80, 170, 90), TextColor3 = Color3.new(1, 1, 1),
}, popup)
corner(acceptBtn)

local declineBtn = make("TextButton", {
	Size = UDim2.fromOffset(140, 40), Position = UDim2.fromOffset(168, 88), Text = "Decline",
	Font = Enum.Font.GothamBold, TextSize = 16,
	BackgroundColor3 = Color3.fromRGB(190, 70, 70), TextColor3 = Color3.new(1, 1, 1),
}, popup)
corner(declineBtn)

acceptBtn.MouseButton1Click:Connect(function()
	popup.Visible = false
	event:FireServer("Respond", true)
end)
declineBtn.MouseButton1Click:Connect(function()
	popup.Visible = false
	event:FireServer("Respond", false)
end)

local toast = make("TextLabel", {
	Size = UDim2.fromOffset(380, 40), Position = UDim2.new(0.5, -190, 1, -70),
	BackgroundColor3 = Color3.fromRGB(30, 30, 42), Font = Enum.Font.Gotham, TextSize = 15,
	TextColor3 = Color3.new(1, 1, 1), Text = "", Visible = false,
}, gui)
corner(toast)

local toastId = 0
local function showToast(msg)
	toastId += 1
	local id = toastId
	toast.Text = msg
	toast.Visible = true
	task.delay(4, function()
		if id == toastId then toast.Visible = false end
	end)
end

event.OnClientEvent:Connect(function(action, a, b, c, d, e)
	if action == "Incoming" then
		popupText.Text = ("%s offers %d brainrots for %d Coins.\nAccept within 30s."):format(b, c, d)
		popup.Visible = true
	elseif action == "TradeExpired" then
		popup.Visible = false
		showToast("Trade offer expired.")
	elseif action == "OpenTrade" then
		frame.Visible = true
		refreshList()
		event:FireServer("ListMySlots")
	elseif action == "MySlots" then
		refreshSlots(a)
	elseif action == "Message" then
		showToast(a)
		if typeof(a) == "string" and a:find("Placed") then
			carryBar.Text = "Carrying: none"
		end
	end
end)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<string name="Name">TradeClient</string>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
